# Streamlit Cloud Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to GitHub

# Lambda API Gateway endpoint for RAG backend
LAMBDA_API_ENDPOINT=https://YOUR_API_ID.execute-api.us-east-1.amazonaws.com/prod/chat

# Bedrock region (should match Lambda region)
BEDROCK_REGION=us-east-1

# MongoDB Atlas enabled flag
MONGODB_ATLAS_ENABLED=true

# Optional: Local development settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=false
