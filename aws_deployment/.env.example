# Local Lambda/Bedrock Testing
# Copy to .env and fill in values for local testing only
# NEVER commit actual credentials to GitHub

# MongoDB URI (usually fetched from AWS Secrets Manager in production)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=ClusterDB

# AWS Region
AWS_REGION=us-east-1

# AWS Profile (for local development with AWS CLI credentials)
AWS_PROFILE=default
